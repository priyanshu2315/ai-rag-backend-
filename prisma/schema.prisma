generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector(schema: "extensions"), pgcrypto(schema: "extensions"), pg_stat_statements(schema: "extensions"), supabase_vault(schema: "vault")]
}

enum UserType {
  ADMIN
  USER
}

enum ConversationType {
  GLOBAL
  DOCUMENT
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  name               String?
  type               UserType       @default(USER)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  resetOtp           String?
  resetOtpExpiresAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  conversations      Conversation[]
  documents          Document[]
  roles              UserRole[]
}

model Role {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  users       UserRole[]
  documents   RoleDocument[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RoleDocument {
  roleId     String
  documentId String
  addedAt    DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([roleId, documentId])
  @@index([documentId])
}

model Document {
  id            String         @id @default(uuid())
  filename      String
  createdAt     DateTime       @default(now())
  fileUrl       String?
  status        String         @default("PROCESSING")
  summaryStatus String         @default("PENDING")
  summary       String?
  userId        String         // uploaded by; not used for access
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id])
  parents       ParentChunk[]
  roles         RoleDocument[]
}

model ParentChunk {
  id         String       @id @default(uuid())
  text       String
  searchText   String
  prevParentId String?
  nextParentId String?
  documentId String
  metadata   Json?
  children   ChildChunk[]
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ChildChunk {
  id         String                @id @default(uuid())
  text       String
  searchText String

  parentId   String
  documentId String
  embedding  Unsupported("vector(384)")
  metadata   Json?
  parent     ParentChunk           @relation(fields: [parentId], references: [id], onDelete: Cascade)
}


model Conversation {
  id         String           @id @default(uuid())
  userId     String
  documentId String?
  type       ConversationType @default(GLOBAL)
  title      String?          @default("New Conversation")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId, type])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?  
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}