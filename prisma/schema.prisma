generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector(schema: "extensions"), pgcrypto(schema: "extensions"), pg_stat_statements(schema: "extensions"), supabase_vault(schema: "vault")]
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  resetOtp          String?
  resetOtpExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  conversations     Conversation[]
  documents         Document[]
}

model Document {
  id            String         @id @default(uuid())
  filename      String
  createdAt     DateTime       @default(now())
  fileUrl       String?
  status        String         @default("PROCESSING")
  summary       String?
  userId        String
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id])
  parents       ParentChunk[]
}

model ParentChunk {
  id         String       @id @default(uuid())
  text       String
  documentId String
  metadata   Json?
  children   ChildChunk[]
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ChildChunk {
  id         String                @id @default(uuid())
  text       String
  parentId   String
  documentId String
  embedding  Unsupported("vector(384)")
  metadata   Json?
  parent     ParentChunk           @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String    @id @default(uuid())
  userId     String
  documentId String?
  title      String?   @default("New Conversation")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
